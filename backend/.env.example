# Backend Environment Configuration (Example)
# In Render, configure these in Service Settings -> Environment.

# Allowed Frontend URLs for CORS (comma-separated, without trailing slashes)
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Authentication Secret (Used for HMAC-SHA256 session token signing)
# Replace with a cryptographically secure random string in production.
# Priority order: SENTINEL_AUTH_SECRET > JWT_SECRET > AUTH_SECRET > SECRET_KEY
SENTINEL_AUTH_SECRET=replace-with-production-secret
