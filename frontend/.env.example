# Frontend Environment Configuration (Example)
# In Vercel, set these in Project Settings -> Environment Variables.
# NOTE: Changing React environment variables requires a new deployment / rebuild.

# Primary Backend URL (Render service URL)
# resolveApiBaseUrl() normalizes this to ensure '/api' is correctly appended.
# Example: https://mplads-sentinel-api.onrender.com
REACT_APP_BACKEND_URL=https://your-render-service.onrender.com

# Alternative supported variable names (priority order: REACT_APP_API_BASE_URL > REACT_APP_BACKEND_URL > REACT_APP_API_URL):
# REACT_APP_API_BASE_URL=https://your-render-service.onrender.com/api
# REACT_APP_API_URL=https://your-render-service.onrender.com/api
